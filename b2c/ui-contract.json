  "components": [
    {
      "selector": "#csat-modal [data-csat-submit]",
      "why": "Review after the medicine arrives. Went missing once already."
    },
    {
      "selector": "#csat-modal [data-csat-advice]",
      "why": "Doctor advice rating."
    },
    {
      "selector": "#csat-modal [data-csat-platform]",
      "why": "App experience rating."
    },
    {
      "selector": "#csat-modal [data-csat-quality]",
      "why": "Video and sound quality rating."
    },
    {
      "selector": "#tracking [data-delivery-confirm]",
      "why": "Patient confirms receipt on the Delivered step."
    },
    {
      "selector": "#health-history-modal",
      "why": "Three safety questions, asked at confirmation."
    },
    {
      "selector": "#waitroom-expired-modal [data-waitroom-retry]",
      "why": "Missing the 5-minute entry window has to offer a re-match, not a dead end."
    },
    {
      "selector": "#waitroom [data-wait-timer]",
      "why": "The entry window is counted down on the waiting room, not left implicit."
    },
    {
      "selector": "#signup-done-modal",
      "why": "Registration-complete confirmation after OTP."
    },
    {
      "selector": "#payment-method-modal [data-method-option]",
      "why": "Payment method sheet, tap to commit."
    },
    {
      "selector": "#prescription [data-doc-tab='summary']",
      "why": "Consultation summary document."
    },
    {
      "selector": "#prescription [data-doc-tab='rx']",
      "why": "Prescription document."
    },
    {
      "selector": "#prescription [data-doc-tab='cert']",
      "why": "Medical certificate."
    },
    {
      "selector": "#prescription [data-doc-tab='receipt']",
      "why": "Receipt."
    },
    {
      "selector": "#tracking [data-doc-open='summary']",
      "why": "Documents reachable from the order."
    },
    {
      "selector": "#tracking [data-doc-open='receipt']",
      "why": "Receipt reachable from the order."
    },
    {
      "selector": "#tracking [data-doc-open='cert']",
      "why": "Certificate reachable from the order."
    },
    {
      "selector": "#address [data-address-search]",
      "why": "Address search box with suggestions."
    },
    {
      "selector": "#address [data-address-suggestions]",
      "why": "Suggestion dropdown."
    },
    {
      "selector": "#address [data-go='address-map']",
      "why": "Map picker entry point."
    },
    {
      "selector": "#address-map [data-osm-map]",
      "why": "Real OpenStreetMap tiles."
    },
    {
      "selector": "#address-map [data-address-map-confirm]",
      "why": "Confirming the pin returns to the form."
    },
    {
      "selector": "#address .form-group",
      "why": "Address fields stay grouped, not one flat run.",
      "minCount": 3
    },
    {
      "selector": "#address .field__clear",
      "why": "Every address field can be cleared.",
      "minCount": 8
    },
    {
      "selector": "#conditions [data-category-list]",
      "why": "Category grid. Its container was dropped once and blanked the screen."
    },
    {
      "selector": "#conditions [data-condition-list]",
      "why": "Second-step condition list."
    },
    {
      "selector": "#waitroom .info-chip",
      "why": "Camera/mic precondition as a one-line chip."
    },
    {
      "selector": "#video .call-btn--end",
      "why": "Hang-up control."
    },
    {
      "selector": "#consult [data-live-pill]",
      "why": "Live-call pill in chat."
    },
    {
      "selector": "#profile .home-cta",
      "why": "Home primary action."
    },
    {
      "selector": "#csat-modal [data-csat-close]",
      "why": "The review is a request after delivery, not a gate — it must be closeable."
    },
    {
      "selector": "#delivery-quote use[href='#krane-state-delivery-quote']",
      "why": "The quote screen uses the house state illustration, like every other flow screen. The crane flipbook was tried here on 20 Aug and reverted on 23 Aug — it belongs to the app's own boot screen."
    },
    {
      "selector": "#delivery-quote [data-delivery-quote-timer]",
      "why": "One state with a counter, not two headings in five seconds."
    },
    {
      "selector": "#payment [data-payment-address-row]",
      "why": "The address the quote returns to. Checkout scrolls to it and pulses it."
    },
    {
      "selector": "#pharmacypending [data-prep-title]",
      "why": "Post-payment pharmacy screen runs two stages in one heading: packing, then packed."
    },
    {
      "selector": "#activity [data-order-progress] .order-progress__step",
      "why": "Orders carry their own progress bar in Activity once the pharmacy is done.",
      "minCount": 4
    },
    {
      "selector": "#appointment [data-appointment-slot]",
      "why": "Sexual health books a time instead of matching a doctor; the slot picker is the screen.",
      "minCount": 6
    },
    {
      "selector": "#appointment [data-appointment-day]",
      "why": "Booking spans more than today, so the day picker must stay.",
      "minCount": 3
    }
  ],
  "flows": [
    {
      "name": "General consultation intake paginates one question per page",
      "enter": "#intake1?entry=direct&category=general",
      "assert": [
        {
          "activeScreen": "intake1"
        },
        {
          "countAtLeast": [
            "[data-intake-question]",
            3
          ]
        },
        {
          "visibleOnly": "[data-intake-question]"
        }
      ]
    },
    {
      "name": "Confirming receipt asks for the review",
      "enter": "#tracking",
      "seed": {
        "entryChannel": "direct",
        "draftReady": true,
        "accountCreated": true,
        "otpVerified": true,
        "consentsComplete": true,
        "identityVerified": true,
        "patientInfoComplete": true,
        "directGeneralHealthComplete": true,
        "consultationFeeAcknowledged": true,
        "consultationPaid": true
      },
      "assert": [
        {
          "visible": "#csat-modal"
        }
      ],
      "assertBeforeClick": [
        {
          "activeScreen": "tracking"
        }
      ],
      "click": "[data-track-step='delivered'] [data-delivery-confirm]"
    },
    {
      "name": "Direct access never asks for an ID card",
      "enter": "#identity",
      "seed": {
        "entryChannel": "direct",
        "draftReady": true,
        "accountCreated": true,
        "otpVerified": true
      },
      "assert": [
        {
          "activeScreen": "patient-info"
        }
      ]
    },
    {
      "name": "Tracking offers the receipt confirmation on the Delivered step",
      "enter": "#tracking",
      "seed": {
        "entryChannel": "direct",
        "draftReady": true,
        "accountCreated": true,
        "otpVerified": true,
        "consentsComplete": true,
        "identityVerified": true,
        "patientInfoComplete": true,
        "directGeneralHealthComplete": true,
        "consultationFeeAcknowledged": true,
        "consultationPaid": true
      },
      "assert": [
        {
          "activeScreen": "tracking"
        },
        {
          "visible": "[data-track-step='delivered'] [data-delivery-confirm]"
        }
      ]
    },
    {
      "name": "Sexual health matches, fails, then books a time",
      "why": "New, 31 Aug: the route to test is matching flagging no doctor and forcing a booking, not a booking screen on its own. Entering at #matching and waiting out the timer asserts the whole beat, so a regression that skips the match attempt fails the build.",
      "enter": "#matching?entry=direct&category=sexual-health",
      "waitBefore": 13000,
      "seed": {
        "entryChannel": "direct",
        "draftReady": true,
        "accountCreated": true,
        "otpVerified": true,
        "consentsComplete": true,
        "patientInfoComplete": true,
        "directGeneralHealthComplete": true,
        "consultationFeeAcknowledged": true
      },
      "assert": [
        {
          "activeScreen": "appointment"
        },
        {
          "visible": "#appointment [data-appointment-confirm]"
        }
      ]
    }
  ],
  "rules": [
    {
      "name": "No eyebrow/kicker labels on the condition page",
      "page": "condition-detail.html?condition=weight",
      "absent": ".eyebrow, .condition-hero__kicker, .detail-kicker, .section-kicker"
    },
    {
      "name": "No kicker labels on the doctors page",
      "page": "doctors.html",
      "absent": ".eyebrow, .detail-kicker, .section-kicker"
    },
    {
      "name": "No kicker labels on the landing page",
      "page": "krane-b2c-landing.html",
      "absent": ".eyebrow, .detail-kicker, .section-kicker"
    },
    {
      "name": "Skip link never takes layout space",
      "page": "krane-b2c-landing.html",
      "maxHeight": [
        ".skip-link",
        2
      ]
    },
    {
      "name": "Skip link never takes layout space (service pages)",
      "page": "condition-detail.html?condition=weight",
      "maxHeight": [
        ".skip-link",
        2
      ]
    },
    {
      "name": "Drawer carries exactly one action",
      "page": "krane-b2c-landing.html",
      "count": [
        ".mobile-menu__actions .button",
        1
      ]
    },
    {
      "name": "Drawer action fills the drawer width",
      "page": "krane-b2c-landing.html",
      "openDrawer": true,
      "fillsParent": [
        ".mobile-menu__actions .button",
        0.95
      ]
    },
    {
      "name": "Drawer action fills the drawer width (service pages)",
      "page": "condition-detail.html?condition=weight",
      "openDrawer": true,
      "fillsParent": [
        ".mobile-menu__actions .button",
        0.95
      ]
    },
    {
      "name": "Actions are rounded rectangles, never pills",
      "page": "krane-b2c.html",
      "noPillButtons": true
    },
    {
      "name": "English mode leaves no Thai on the landing page",
      "page": "krane-b2c-landing.html?lang=en",
      "noThaiInEnglish": true
    },
    {
      "name": "English mode leaves no Thai on the doctors page",
      "page": "doctors.html?lang=en",
      "noThaiInEnglish": true
    },
    {
      "name": "English mode leaves no Thai on a condition page",
      "page": "condition-detail.html?condition=ed&lang=en",
      "noThaiInEnglish": true
    },
    {
      "name": "English mode leaves no Thai on a doctor profile",
      "page": "doctor-detail.html?lang=en",
      "noThaiInEnglish": true
    },
    {
      "name": "English mode leaves no Thai on the adviser page",
      "page": "advisor-detail.html?lang=en",
      "noThaiInEnglish": true
    },
    {
      "name": "English mode leaves no Thai in the app",
      "page": "krane-b2c.html?lang=en",
      "noThaiInEnglish": true
    },
    {
      "name": "Checkout reads in delivery-app order",
      "page": "krane-b2c.html#payment",
      "order": [
        "#payment .screen__body",
        [
          "[data-fulfillment-mode-option]",
          "[data-payment-address-row]",
          "[data-delivery-option]",
          "[data-payment-addons]",
          "[data-payment-method]",
          ".checkout-final-summary"
        ]
      ]
    },
    {
      "name": "Navigation bar stays a floating capsule, not a docked bar",
      "page": "krane-b2c.html#profile",
      "box": [
        ".screen.active .bottomnav",
        {
          "height": 60
        }
      ]
    },
    {
      "name": "Navigation bar keeps the pill behind the active icon",
      "page": "krane-b2c.html#profile",
      "box": [
        ".screen.active .bottomnav a[aria-current='page'] .ic",
        {
          "width": 52,
          "height": 40
        }
      ]
    }
  ]
