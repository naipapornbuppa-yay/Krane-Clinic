{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Krane optional article section presentation",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string"
    },
    "copy": {
      "type": "string"
    },
    "presentation": {
      "enum": [
        "text",
        "callout",
        "steps",
        "comparison"
      ],
      "default": "text"
    },
    "media": {
      "type": "object",
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^(https://|assets/)[^\\s<>]+$"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "heading",
    "copy"
  ]
}
