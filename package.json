{
  "name": "krane-clinic-prototype",
  "private": true,
  "description": "Static Krane Clinic prototype. The only tooling here is the UI contract check that keeps agreed work from disappearing between releases.",
  "scripts": {
    "check:ui": "node b2c/tools/check-ui.mjs",
    "check:strings": "node b2c/tools/check-string-ids.mjs",
    "check:public": "node b2c/tools/public-redesign-qa.mjs",
    "check:consent": "node b2c/tools/cookie-consent-qa.mjs",
    "check:motion": "node b2c/tools/landing-motion-qa.mjs",
    "check:landing-css": "node --test b2c/tools/landing-css-cleanup.test.mjs && node b2c/tools/landing-css-cleanup.mjs",
    "clean:landing-css": "node b2c/tools/landing-css-cleanup.mjs --write",
    "check:landing-refactor": "node b2c/tools/landing-refactor-qa.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "postcss": "8.5.6",
    "postcss-selector-parser": "7.1.0"
  }
}
