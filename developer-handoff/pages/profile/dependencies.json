{
  "screen": "profile",
  "pathsRelativeTo": "developer-handoff/",
  "classification": "owned",
  "template": "pages/profile/index.html",
  "script": "pages/profile/page.js",
  "styles": "pages/profile/page.css",
  "lifecycle": {
    "mount": "Build-time composition into shared/shell.html, before scripts execute.",
    "initialize": "Page-owned kraneInit_* routines are called once by shared/runtime.js in dependency order. Do not call again on each route change.",
    "activate": "Shared show() changes active screen and emits krane:screenchange. Page functions respond through shared router or their registered listeners.",
    "unmount": "Not supported during a running session. Existing shared handlers retain DOM references; keep templates mounted until the app is disposed."
  },
  "behavior": {
    "note": "Owns treatment-folder rendering, capture animation, re-entry selection and paused-program folder status/order. Shared program store/schedule remain central.",
    "sources": [
      "pages/profile/page.js",
      "shared/lib/navigation.js"
    ]
  },
  "eventHandlers": [
    {
      "name": "kraneHandle_profile_followUpCase",
      "condition": "followUpCaseOpen",
      "selectors": [
        "[data-followup-case-open]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_profile_followUpJoin",
      "condition": "followUpJoin",
      "selectors": [
        "[data-followup-join]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_profile_treatmentOpen",
      "condition": "treatmentOpen",
      "selectors": [
        "[data-treatment-open]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_profile_followUp",
      "condition": "profileFollowup",
      "selectors": [
        "[data-profile-followup]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_profile_referral",
      "condition": "profileReferral",
      "selectors": [
        "[data-referral-modal]",
        "[data-profile-referral]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_profile_newAppointment",
      "condition": "profileNewAppointment",
      "selectors": [
        "[data-profile-new-appointment]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    }
  ],
  "routeHooks": [],
  "interfaces": [],
  "functions": [
    "syncTreatmentStatus",
    "syncHomeFollowUpCta",
    "openRefillSheet",
    "kraneHandle_profile_followUpCase",
    "kraneHandle_profile_followUpJoin",
    "kraneHandle_profile_treatmentOpen",
    "kraneHandle_profile_followUp",
    "kraneHandle_profile_referral",
    "kraneHandle_profile_newAppointment",
    "kraneInitProfileTreatmentFolders",
    "kraneCreateProfileProgramPresentation"
  ],
  "orderedInitializers": [
    "kraneInit_profile_320",
    "kraneInit_profile_322"
  ],
  "dependencies": [
    {
      "name": "FOLLOWUP_GRACE_MS",
      "source": "shared/runtime.js"
    },
    {
      "name": "FOLLOWUP_JOIN_MS",
      "source": "shared/runtime.js"
    },
    {
      "name": "FOLLOWUP_NOTICE_MS",
      "source": "shared/runtime.js"
    },
    {
      "name": "availableRefillKeys",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "beginAssignedDoctorFlow",
      "source": "pages/intake-general/page.js"
    },
    {
      "name": "flowState",
      "source": "shared/runtime.js"
    },
    {
      "name": "followUpAppointmentFor",
      "source": "shared/lib/clinical.js"
    },
    {
      "name": "formatFollowUpDate",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "formatFollowUpPill",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "formatFollowUpTime",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "journeyActive",
      "source": "shared/runtime.js"
    },
    {
      "name": "kraneRenderTreatmentVisitHistory",
      "source": "pages/treatment-detail/page.js"
    },
    {
      "name": "openTreatmentDetail",
      "source": "pages/treatment-detail/page.js"
    },
    {
      "name": "persistFlowState",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "refillCardFor",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "refillSheet",
      "source": "shared/runtime.js"
    },
    {
      "name": "selectedCategoryId",
      "source": "shared/runtime.js"
    },
    {
      "name": "show",
      "source": "shared/lib/navigation.js"
    },
    {
      "name": "syncFollowUpCaseStates",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "syncFollowUpDates",
      "source": "shared/lib/ui.js"
    }
  ],
  "externalDependencies": [
    "Shared CSS, icons, select enhancement, i18n and store adapters; see shared/shell.html and page-ownership-inventory.json. Page-specific external renderers are now page-owned."
  ],
  "productionBoundary": "Prototype auth/storage/payment are demonstrations. Replace via agreed backend contracts; do not accept browser flags as authorization."
}
