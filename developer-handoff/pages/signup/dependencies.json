{
  "screen": "signup",
  "pathsRelativeTo": "developer-handoff/",
  "classification": "owned",
  "template": "pages/signup/index.html",
  "script": "pages/signup/page.js",
  "styles": "pages/signup/page.css",
  "lifecycle": {
    "mount": "Build-time composition into shared/shell.html, before scripts execute.",
    "initialize": "Page-owned kraneInit_* routines are called once by shared/runtime.js in dependency order. Do not call again on each route change.",
    "activate": "Shared show() changes active screen and emits krane:screenchange. Page functions respond through shared router or their registered listeners.",
    "unmount": "Not supported during a running session. Existing shared handlers retain DOM references; keep templates mounted until the app is disposed."
  },
  "behavior": {
    "note": "Page-specific functions, rendering and lifecycle are in page.js; cross-page state/services and generic components remain shared.",
    "sources": [
      "pages/signup/page.js",
      "shared/lib/navigation.js"
    ]
  },
  "eventHandlers": [
    {
      "name": "kraneHandle_signup_submit",
      "condition": "signupPhone",
      "selectors": [
        "[data-signup-phone]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_signup_newAccount",
      "condition": "newAccount",
      "selectors": [
        "[data-new-account]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    }
  ],
  "routeHooks": [
    {
      "kind": "statements",
      "name": "kraneSignupArrivalToast",
      "owner": "pages/signup/page.js",
      "dispatch": "shared/lib/navigation.js",
      "params": [
        "shouldShowSignupIntakeToast"
      ],
      "sourceLine": 268
    }
  ],
  "interfaces": [],
  "functions": [
    "signupPasswordReady",
    "syncSignupPassword",
    "syncSignupSubmit",
    "kraneHandle_signup_submit",
    "kraneHandle_signup_newAccount",
    "kraneSignupArrivalToast"
  ],
  "orderedInitializers": [
    "kraneInit_signup_98",
    "kraneInit_signup_initialSubmit",
    "kraneInit_signup_doneDialog"
  ],
  "dependencies": [
    {
      "name": "closeSignupDoneModal",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "flowState",
      "source": "shared/runtime.js"
    },
    {
      "name": "formatPhoneForDisplay",
      "source": "shared/lib/identity.js"
    },
    {
      "name": "isValidThaiMobile",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "normalizePhone",
      "source": "shared/lib/identity.js"
    },
    {
      "name": "passwordRuleState",
      "source": "shared/lib/identity.js"
    },
    {
      "name": "persistFlowState",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "postAuthNext",
      "source": "shared/runtime.js"
    },
    {
      "name": "show",
      "source": "shared/lib/navigation.js"
    },
    {
      "name": "showActionToast",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "signupDoneModal",
      "source": "shared/runtime.js"
    },
    {
      "name": "signupDoneTarget",
      "source": "shared/runtime.js"
    },
    {
      "name": "submitOnce",
      "source": "shared/lib/ui.js"
    }
  ],
  "externalDependencies": [
    "Shared CSS, icons, select enhancement, i18n and store adapters; see shared/shell.html and page-ownership-inventory.json. Page-specific external renderers are now page-owned."
  ],
  "productionBoundary": "Prototype auth/storage/payment are demonstrations. Replace via agreed backend contracts; do not accept browser flags as authorization."
}
