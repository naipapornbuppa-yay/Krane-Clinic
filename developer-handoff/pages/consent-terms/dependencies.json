{
  "screen": "consent-terms",
  "template": "pages/consent-terms/index.html",
  "script": "pages/consent-terms/page.js",
  "styles": "pages/consent-terms/page.css",
  "lifecycle": {
    "mount": "Build-time composition into shared/shell.html, before scripts execute.",
    "initialize": "Page-owned kraneInit_* routines are called once by shared/runtime.js in dependency order. Do not call again on each route change.",
    "activate": "Shared show() changes active screen and emits krane:screenchange. Page functions respond through shared router or their registered listeners.",
    "unmount": "Not supported during a running session. Existing shared handlers retain DOM references; keep templates mounted until the app is disposed."
  },
  "behavior": {
    "note": "Page-owned functions/handlers live in this script; state, navigation and generic controls use shared libraries.",
    "sources": []
  },
  "eventHandlers": [
    {
      "name": "kraneHandle_consent_terms_submit",
      "condition": "consentSubmit",
      "selectors": [
        "[data-consent-continue]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    }
  ],
  "functions": [
    "unlockConsentBundleAfterDelay",
    "kraneHandle_consent_terms_submit"
  ],
  "orderedInitializers": [
    "kraneInit_consent_terms_owned_79",
    "kraneInit_consent_terms_owned_81",
    "kraneInit_consent_terms_owned_82",
    "kraneInit_consent_terms_owned_83",
    "kraneInit_consent_terms_owned_85",
    "kraneInit_consent_terms_initialContinue"
  ],
  "dependencies": [
    {
      "name": "checkConsentScrollEnd",
      "source": "shared/lib/intake.js"
    },
    {
      "name": "consentAutoCheckTimer",
      "source": "shared/runtime.js"
    },
    {
      "name": "consentAutoScroll",
      "source": "shared/runtime.js"
    },
    {
      "name": "consentChecked",
      "source": "shared/runtime.js"
    },
    {
      "name": "consentChecks",
      "source": "shared/runtime.js"
    },
    {
      "name": "consentDocuments",
      "source": "shared/runtime.js"
    },
    {
      "name": "consentIdentityVerified",
      "source": "shared/lib/intake.js"
    },
    {
      "name": "consentPageScroll",
      "source": "shared/runtime.js"
    },
    {
      "name": "consentRead",
      "source": "shared/runtime.js"
    },
    {
      "name": "flowState",
      "source": "shared/runtime.js"
    },
    {
      "name": "markConsentRead",
      "source": "shared/lib/intake.js"
    },
    {
      "name": "nextAfterAuthentication",
      "source": "shared/lib/identity.js"
    },
    {
      "name": "openSignupDoneModal",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "persistFlowState",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "renderConsentReadState",
      "source": "shared/lib/intake.js"
    },
    {
      "name": "requiredConsentChecks",
      "source": "shared/runtime.js"
    },
    {
      "name": "saveConsentRecords",
      "source": "shared/lib/intake.js"
    },
    {
      "name": "show",
      "source": "shared/lib/navigation.js"
    },
    {
      "name": "showActionToast",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "submitOnce",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "syncConsentContinue",
      "source": "shared/lib/intake.js"
    }
  ],
  "externalDependencies": [
    "Existing b2c shared CSS, icons, select enhancement, i18n, clinical demo/storage adapters; see shared/shell.html."
  ],
  "productionBoundary": "Prototype auth/storage/payment are demonstrations. Replace via agreed backend contracts; do not accept browser flags as authorization."
}
