{
  "screen": "intake-general",
  "template": "pages/intake-general/index.html",
  "script": "pages/intake-general/page.js",
  "styles": "pages/intake-general/page.css",
  "lifecycle": {
    "mount": "Build-time composition into shared/shell.html, before scripts execute.",
    "initialize": "Page-owned kraneInit_* routines are called once by shared/runtime.js in dependency order. Do not call again on each route change.",
    "activate": "Shared show() changes active screen and emits krane:screenchange. Page functions respond through shared router or their registered listeners.",
    "unmount": "Not supported during a running session. Existing shared handlers retain DOM references; keep templates mounted until the app is disposed."
  },
  "behavior": {
    "note": "Page-owned functions/handlers live in this script; state, navigation and generic controls use shared libraries.",
    "sources": []
  },
  "eventHandlers": [
    {
      "name": "kraneHandle_intake_general_partnerHistory",
      "condition": "partnerHistoryChoice",
      "selectors": [
        "[data-partner-history]",
        "input",
        "[data-partner-history-choice]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_intake_general_screening",
      "condition": "partnerScreeningOption",
      "selectors": [
        "[data-partner-screening-question]",
        "[data-partner-screening-value]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_intake_general_submit",
      "condition": "intakeComplete.closest('#intake-general')",
      "selectors": [
        "#intake-general",
        "[data-intake-complete]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    }
  ],
  "functions": [
    "beginAssignedDoctorFlow",
    "syncGeneralHealthContext",
    "directNextAfterPatientInfo",
    "updateFollowUpPrefillCard",
    "completeSharedHealthIntake",
    "kraneHandle_intake_general_partnerHistory",
    "kraneHandle_intake_general_screening",
    "kraneHandle_intake_general_submit"
  ],
  "orderedInitializers": [
    "kraneInit_intake_general_owned_302"
  ],
  "dependencies": [
    {
      "name": "captureFollowUpRecord",
      "source": "pages/intake1/page.js"
    },
    {
      "name": "closeHealthHistoryModal",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "directClinicalStartTarget",
      "source": "pages/matching/page.js"
    },
    {
      "name": "directHistoryValue",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "flowState",
      "source": "shared/runtime.js"
    },
    {
      "name": "followUpRecordFor",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "healthHistoryModal",
      "source": "shared/runtime.js"
    },
    {
      "name": "history",
      "source": "shared/runtime.js"
    },
    {
      "name": "hydrateFollowUpRecord",
      "source": "pages/intake1/page.js"
    },
    {
      "name": "journeyActive",
      "source": "shared/runtime.js"
    },
    {
      "name": "nextAfterAuthentication",
      "source": "shared/lib/identity.js"
    },
    {
      "name": "openHealthHistoryModal",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "partnerClinicalStartTarget",
      "source": "pages/matching/page.js"
    },
    {
      "name": "persistFlowState",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "postAuthNext",
      "source": "shared/runtime.js"
    },
    {
      "name": "saveIntakeDraft",
      "source": "pages/intake-concern/page.js"
    },
    {
      "name": "selectedCategoryId",
      "source": "shared/runtime.js"
    },
    {
      "name": "setPartnerHistoryChoice",
      "source": "shared/lib/intake.js"
    },
    {
      "name": "setSelectedCategory",
      "source": "shared/lib/intake.js"
    },
    {
      "name": "show",
      "source": "shared/lib/navigation.js"
    },
    {
      "name": "showActionToast",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "signedIn",
      "source": "shared/lib/ui.js"
    },
    {
      "name": "syncPartnerScreening",
      "source": "shared/lib/intake.js"
    }
  ],
  "externalDependencies": [
    "Existing b2c shared CSS, icons, select enhancement, i18n, clinical demo/storage adapters; see shared/shell.html."
  ],
  "productionBoundary": "Prototype auth/storage/payment are demonstrations. Replace via agreed backend contracts; do not accept browser flags as authorization."
}
