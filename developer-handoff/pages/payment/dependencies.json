{
  "screen": "payment",
  "template": "pages/payment/index.html",
  "script": "pages/payment/page.js",
  "styles": "pages/payment/page.css",
  "lifecycle": {
    "mount": "Build-time composition into shared/shell.html, before scripts execute.",
    "initialize": "Page-owned kraneInit_* routines are called once by shared/runtime.js in dependency order. Do not call again on each route change.",
    "activate": "Shared show() changes active screen and emits krane:screenchange. Page functions respond through shared router or their registered listeners.",
    "unmount": "Not supported during a running session. Existing shared handlers retain DOM references; keep templates mounted until the app is disposed."
  },
  "behavior": {
    "note": "Page-owned functions/handlers live in this script; state, navigation and generic controls use shared libraries.",
    "sources": []
  },
  "eventHandlers": [
    {
      "name": "kraneHandle_payment_fulfillment",
      "condition": "fulfillmentModeChoice",
      "selectors": [
        "[data-fulfillment-mode-option]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_payment_delivery",
      "condition": "deliveryChoice",
      "selectors": [
        "[data-delivery-value]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_payment_editAddon",
      "condition": "addOnEdit",
      "selectors": [
        "[data-order-addon]",
        "[data-addon-edit]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_payment_removeAddon",
      "condition": "addOnRemove",
      "selectors": [
        "[data-addon-remove]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_payment_addAddon",
      "condition": "addOnChoice",
      "selectors": [
        "[data-addon-option]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    },
    {
      "name": "kraneHandle_payment_deadlineRetry",
      "condition": "event.target.closest('[data-payment-deadline-retry]')",
      "selectors": [
        "[data-payment-deadline-retry]"
      ],
      "dispatch": "shared/runtime.js",
      "consumesOn": "true (including failed validation)",
      "fallsThroughOn": "false"
    }
  ],
  "functions": [
    "syncPaymentFooterSavings",
    "enforceCheckoutSequence",
    "syncOrderCheckout",
    "confirmListAddress",
    "startRefill",
    "flagCheckoutBlocker",
